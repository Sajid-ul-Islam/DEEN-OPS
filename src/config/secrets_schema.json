{
  "sections": {
    "woocommerce": {
      "required": false,
      "keys": {
        "store_url": {
          "env": "WC_URL",
          "aliases": [
            "url"
          ]
        },
        "consumer_key": {
          "env": "WC_KEY"
        },
        "consumer_secret": {
          "env": "WC_SECRET"
        }
      }
    },
    "pathao": {
      "required": false,
      "keys": {
        "base_url": {
          "env": "PATHAO_BASE_URL"
        },
        "client_id": {
          "env": "PATHAO_CLIENT_ID"
        },
        "client_secret": {
          "env": "PATHAO_CLIENT_SECRET"
        },
        "username": {
          "env": "PATHAO_USERNAME"
        },
        "password": {
          "env": "PATHAO_PASSWORD"
        }
      }
    },
    "auth": {
      "required": false,
      "only_if_present": true,
      "keys": {
        "redirect_uri": {},
        "cookie_secret": {}
      },
      "children": {
        "google": {
          "keys": {
            "client_id": {},
            "client_secret": {},
            "server_metadata_url": {}
          }
        }
      }
    }
  }
}
