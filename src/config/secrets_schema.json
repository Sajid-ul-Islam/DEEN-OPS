{
  "sections": {
    "woocommerce": {
      "required": false,
      "keys": {
        "store_url": {
          "env": "WC_URL",
          "aliases": [
            "url"
          ]
        },
        "consumer_key": {
          "env": "WC_KEY"
        },
        "consumer_secret": {
          "env": "WC_SECRET"
        }
      }
    },
    "pathao": {
      "required": false,
      "keys": {
        "base_url": {
          "env": "PATHAO_BASE_URL"
        },
        "client_id": {
          "env": "PATHAO_CLIENT_ID"
        },
        "client_secret": {
          "env": "PATHAO_CLIENT_SECRET"
        },
        "username": {
          "env": "PATHAO_USERNAME"
        },
        "password": {
          "env": "PATHAO_PASSWORD"
        }
      }
    },
    "llm": {
      "required": false,
      "at_least_one": true,
      "provider_keys": {
        "openrouter": {
          "section_key": "openrouter_key",
          "env": "OPENROUTER_API_KEY",
          "legacy_secret": "OPENROUTER_KEYS"
        },
        "gemini_free": {
          "section_key": "gemini_key",
          "env": "GEMINI_API_KEY",
          "legacy_secret": "GEMINI_KEYS"
        },
        "groq_free": {
          "section_key": "groq_key",
          "env": "GROQ_API_KEY",
          "legacy_secret": "GROQ_KEYS"
        },
        "huggingface": {
          "section_key": "huggingface_key",
          "env": "HF_API_KEY",
          "legacy_secret": "HF_KEYS"
        }
      }
    },
    "auth": {
      "required": false,
      "only_if_present": true,
      "keys": {
        "redirect_uri": {},
        "cookie_secret": {}
      },
      "children": {
        "google": {
          "keys": {
            "client_id": {},
            "client_secret": {},
            "server_metadata_url": {}
          }
        }
      }
    }
  }
}
